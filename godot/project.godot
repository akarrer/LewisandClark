; Engine configuration file.
; Lewis & Clark — Corps of Discovery (Godot spike, see docs/adr/0007).

config_version=5

[application]

config/name="Lewis & Clark — Corps of Discovery"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameInput="*res://scripts/input_setup.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
environment/ssao/quality=3
environment/ssil/quality=3
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
textures/default_filters/anisotropic_filtering_level=4
mesh_lod/lod_change/threshold_pixels=0.5
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)

[shader_globals]

sky_horizon={
"type": "color",
"value": Color(0.68, 0.79, 0.9, 1)
}
cloud_cover={
"type": "float",
"value": 0.42
}
cloud_shadow_strength={
"type": "float",
"value": 0.0
}
sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
wind_strength={
"type": "float",
"value": 1.0
}
wetness={
"type": "float",
"value": 0.0
}
night_amount={
"type": "float",
"value": 0.0
}
river_mist={
"type": "float",
"value": 0.0
}
