; Engine configuration file.
; Lewis & Clark — Corps of Discovery (Godot spike, see docs/adr/0007).

config_version=5

[application]

config/name="Lewis & Clark — Corps of Discovery"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameInput="*res://scripts/input_setup.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)

[shader_globals]

sky_horizon={
"type": "color",
"value": Color(0.68, 0.79, 0.9, 1)
}
